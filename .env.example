# Supabase environment variables (DO NOT commit real secrets)
# Public (client) key - safe to use in client but limited by RLS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=anon_key_here

# Optional: Service role key (sensitive, do NOT commit). Only use in trusted servers/workers.
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_here
